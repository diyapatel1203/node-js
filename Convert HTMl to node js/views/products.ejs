<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Html To Node</title>
  </head>
  <body>
    <%- include('partials/header') %>

    <h1>Add a New Product</h1>
    <form action="/products/add" method="POST">
      <input type="text" name="name" placeholder="Product Name" required />
      <input type="number" name="price" placeholder="Product Price" required />
      <textarea
        name="description"
        placeholder="Product Description"
        required
      ></textarea>
      <input type="text" name="imageUrl" placeholder="Image URL" required />
      <button style="margin-left: 39%;" type="submit">Add Product</button>
    </form>

    <ul>
      <% products.forEach(product => { %>
        <div style="width: 100%; height: 50%;">
          <li>
            <h2 style="text-align: center;"><%= product.name %></h2>
            <p style="margin-left: 25%;"><%= product.description %></p>
            <h4 style="text-align: center;">Price: $<%= product.price %></h4>
            <img height="300" style="margin-left: 30%;" width="300" src="<%= product.imageUrl %>" alt="<%= product.name %>">
            
            <!-- Edit and Delete buttons -->
            <div style="margin-left: 40%;margin-top: 5%;">
              <a style="text-decoration: none; color: white; background-color: black;padding: 10px 20px;border-radius: 5px;" href="/products/edit/<%= product._id %>">Edit</a>
            <form  action="/products/delete/<%= product._id %>" method="POST" style="display: inline;">
              <button type="submit">Delete</button>
            </form>
            </div>
          </li>
        </div>
      <% }) %>
    </ul>
  </body>
</html>
